<?xml version="1.0" encoding="utf-8" ?>
<creature>
  <!--
    info - 관찰 레벨과는 관련 없는 정보들 ex)데미지, id, 이미지 소스 등
    
    observe - 관찰 정도에 따라 제공되는 정보들
              각 정보들에는 정보가 제공되는 레벨을 표기
              ex) <desc id="1" openLevel="1">"openLevel이 1일 때 이 정보가 제공됨"</desc>
              
              observe 노드 안의 level 은 관찰 단계의 갯수를 나타냄
              
    <feeling max="100" downProb="0.44" downValue="1">
      <section feelingValue="50" state="good" energy="0.5"/>
      <section feelingValue="30" state="normal" energy="0.3"/>
      <section feelingValue="0" state="bad" energy="-1.3"/>
    </feeling>

  -->
  <info id ="100029" >


    <narration action="move">
      #0被指派至$0的收容單元內，開始對$0進行工作。
    </narration>

    <narration action="start">
      [
      {赤條條地來到這世上之人，終將赤條條地歸於塵土。},
      {$0記得內心的黑灰。},
      ]
    </narration>

    <narration action="mid1">
      [
      {我們或許是想創造出沒有心的人吧。},
      {永不凋謝的花朵肆意綻放。},
      ]
    </narration>

    <narration action="mid2">
      [
      {#0渴望著如花般的春眠。},
      {#0為那將逐漸暈染收容單元而逼近的薰衣草叢感到激動。},
      ]
    </narration>

    <narration action="mid3">
      [
      {縱然盛開後凋零，但領悟到復活意義的$0，無論走到哪裡都會留下痕跡。而所有的生命都將聚集至$0。},
      {陷入花中沉睡的#0，散發出的不再是血液，而是清幽濃郁的香氣。}
      {花朵在每個人的心中綻放。}
      ]
    </narration>

  </info>

  <observe level ="5">
    <collection>
      <codeNo openLevel ="0">T-04-53</codeNo>
      <portrait openLevel ="1">Sprites/Unit/creature/Alriune</portrait>

      <name openLevel ="1">
        愛娜溫
      </name>
      
      <riskLevel openLevel ="1">
        WAW
      </riskLevel>
      



       <openText>懷抱著歸於泥土的願望，她將和所有渴望生存之物一同歸於墳墓。</openText>

    </collection>

    <desc id="1" openLevel="0">
      [
      {此異想體知曉春之誕生與秋之消逝。}
      ]
    </desc>

    <desc id="2" openLevel="1">
      [
      {其表面如同陶瓷般光滑。本該有眼睛的位置空無一物。而裂縫則由生長而出的植物填滿。}
      ]
    </desc>

    <desc id="3" openLevel="2">
      [
      {<i>可愛的愛娜溫，曾渴望成為人類的玩偶，帶著裝載靈魂的雙眸，備受人們疼愛地活著。</i>}
      ]
    </desc>

    <desc id="4" openLevel="3">
      [
      {<i>被拋棄在黑暗森林裡的愛娜溫，眼珠遭貪圖光芒的烏鴉竊走，心靈、生命與心臟皆逐漸黯淡枯萎。</i>}
      ]
    </desc>

    <desc id="5" openLevel="4">
      [
      {<i>雙眼雖失明卻能看透萬物的愛娜溫，曾渴望成為玩偶的人。懷抱著歸於泥土的願望，她將和所有渴望生存之物一同歸於墳墓。</i>}
      ]
    </desc>


    <specialTipSize size="2">
      <specialTip openLevel="1" key="PanicDeath">當工作結果為優時，$0的逆卡巴拉計數器有高機率在倒數計時結束後減少。</specialTip>
      <specialTip openLevel="1" key="PanicDeath2">當工作結果為差時，$0的逆卡巴拉計數器有高機率在倒數計時結束後減少。</specialTip>
    </specialTipSize>
    


  </observe>



</creature>