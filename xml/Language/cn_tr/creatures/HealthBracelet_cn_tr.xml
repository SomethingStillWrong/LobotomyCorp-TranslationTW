<?xml version="1.0" encoding="utf-8" ?>
<creature>
  <!--
    info - 관찰 레벨과는 관련 없는 정보들 ex)데미지, id, 이미지 소스 등
    
    observe - 관찰 정도에 따라 제공되는 정보들
              각 정보들에는 정보가 제공되는 레벨을 표기
              ex) <desc id="1" openLevel="1">"openLevel이 1일 때 이 정보가 제공됨"</desc>
              
              observe 노드 안의 level 은 관찰 단계의 갯수를 나타냄
  -->
  <info id="300106">
    <narration action="move">
      #0被指派至$0的收容單元內，開始對$0進行工作。
    </narration>
  </info>

  <observe level ="4">
    <collection>
      <codeNo openLevel ="0">O-09-95</codeNo>
      <portrait openLevel ="1">Sprites/Unit/creature/HealthBracelet</portrait>

      <name openLevel ="1">
        發光手鐲
      </name>

      <riskLevel openLevel ="1">
        TETH
      </riskLevel>


      <openText>手鐲不會原諒這種貪婪之人，因此&#13;&#10;務必只能讓迫切需要的人來佩戴。</openText>

    </collection>

    <desc id="1" openLevel="0">
      [
      {我們在郊區發現了許多無法解釋的事物，而散發著淡淡&#13;&#10;玉色光芒的手鐲，便是其中之一。}
      ]
    </desc>

    <desc id="2" openLevel="1">
      [
      {戴上手鐲時，佩戴者的傷口將會被完全治癒，不留一點&#13;&#10;痕跡。}
      ]
    </desc>

    <desc id="3" openLevel="2">
      [
      {然而，若沒有可治癒的傷口，持續佩戴手鐲的行為將會&#13;&#10;被視為貪婪。}
      ]
    </desc>

    <desc id="4" openLevel="3">

      [
      {手鐲不會原諒這種貪婪之人，因此務必只能讓迫切需要&#13;&#10;的人來佩戴。}
      ]
    </desc>

    <specialTipSize size="4">
      <specialTip openLevel="1" key="1">佩戴$0後，佩戴者的最大生命值將會大幅提升。</specialTip>
      <specialTip openLevel="2" key="2">當佩戴者的生命值降低時，&#13;&#10;$0會不斷為其恢復生命值。</specialTip>
      <specialTip openLevel="2" key="3">若佩戴者未在生命值為滿時就試圖歸還$0，&#13;&#10;則佩戴者將會立即死亡。</specialTip>
      <specialTip openLevel="2" key="4">若佩戴者未曾在一段時間內損失生命值，則佩戴者會因&#13;&#10;$0提供過量恢復的副作用而立即死亡。</specialTip>
    </specialTipSize>


  </observe>
</creature>