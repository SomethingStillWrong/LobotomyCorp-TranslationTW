<?xml version="1.0" encoding="utf-8" ?>
<creature>
  <!--
    info - 관찰 레벨과는 관련 없는 정보들 ex)데미지, id, 이미지 소스 등
    
    observe - 관찰 정도에 따라 제공되는 정보들
              각 정보들에는 정보가 제공되는 레벨을 표기
              ex) <desc id="1" openLevel="1">"openLevel이 1일 때 이 정보가 제공됨"</desc>
              
              observe 노드 안의 level 은 관찰 단계의 갯수를 나타냄
  -->
  <info id="300103">

    <narration action="move">
      #0被指派至$0的收容單元內，開始對$0進行工作。
    </narration>
  </info>

  <observe level ="4">
    <collection>
      <codeNo openLevel ="0">T-09-90</codeNo>
      <portrait openLevel ="1">Sprites/Unit/creature/ProphecyOfSkin</portrait>

      <name openLevel ="1">
        皮膚預言
      </name>

      <riskLevel openLevel ="1">
        TETH
      </riskLevel>

      <openText>
        賜給我們救贖吧。真理&#13;&#10;必叫我們得以自由。
      </openText>

    </collection>

    <desc id="1" openLevel="0">
      [
      {一本看起來年代久遠的宗教書籍放置在瘦削的支架上。&#13;&#10;無數用舊羊皮紙所寫的頁面被固定著。}
      ]
    </desc>

    <desc id="2" openLevel="1">
      [
      {信徒們用皮膚裝訂書籍，祈求其神聖永不褪色。}
      ]
    </desc>

    <desc id="3" openLevel="2">
      [
      {翻開這本書的封面，職員將會領悟到無法想像的真理。&#13;&#10;那些精通所有真理之人，將會受到先知的召喚，&#13;&#10;且絕無法拒絕。}
      ]
    </desc>

    <desc id="4" openLevel="3">
      [
      {賜給我們救贖吧。真理必叫我們得以自由。}
      ]
    </desc>


    <specialTipSize size="4">
      <specialTip openLevel="1" key="1">閱讀$0的員工將會獲得額外的精神值加成。</specialTip>
      <specialTip openLevel="2" key="2">員工可以持續閲讀$0，直到精神值&#13;&#10;達到此異想體的加成極限為止。</specialTip>
      <specialTip openLevel="2" key="3">隨著閲讀次數的增加，員工對白色傷害的抗性&#13;&#10;就會越低。</specialTip>
      <specialTip openLevel="2" key="4">閲讀過$0的員工一旦陷入恐慌，就會瞬間消失。</specialTip>
    </specialTipSize>



  </observe>
</creature>