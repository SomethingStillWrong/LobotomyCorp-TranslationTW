<?xml version="1.0" encoding="utf-8" ?>
<creature>
  <!--
    info - 관찰 레벨과는 관련 없는 정보들 ex)데미지, id, 이미지 소스 등
    
    observe - 관찰 정도에 따라 제공되는 정보들
              각 정보들에는 정보가 제공되는 레벨을 표기
              ex) <desc id="1" openLevel="1">"openLevel이 1일 때 이 정보가 제공됨"</desc>
              
              observe 노드 안의 level 은 관찰 단계의 갯수를 나타냄
  -->
  <info id="300105">

    <narration action="move">
      #0被指派至$0的收容單元內，開始對$0進行工作。
    </narration>
  </info>

  <observe level ="4">
    <collection>
      <codeNo openLevel ="0">T-09-94</codeNo>
      <portrait openLevel ="1">Sprites/Unit/creature/YouMusHappy</portrait>

      <name openLevel ="1">
        你必須要幸福
      </name>

      <riskLevel openLevel ="1">
        ZAYIN
      </riskLevel>

      <openText>
        許多在機器內接受治療的人，都重獲了休息，恢復了健康。
      </openText>

    </collection>

    <desc id="1" openLevel="0">
      [
      {此異想體是一台處處顯得斑駁老舊、用途不明的醫療用機器。}
      ]
    </desc>

    <desc id="2" openLevel="1">
      [
      {這台能在頭蓋骨裡四處翻攪穿梭的機器，被設計得很適合安全且有效地破壞神經組織。}
      ]
    </desc>

    <desc id="3" openLevel="2">
      [
      {許多在機器內接受治療的人，都重獲了休息，恢復了健康。}
      ]
    </desc>

    <desc id="4" openLevel="3">
      [
      {當被問及「是否愛你的城市？」時，回答「是」的人被視為病情好轉；回答「不是」的人則無法出院。}
      ]
    </desc>

    <desc id="5" openLevel="4">
      [
      {機器使用時間越長，員工的狀態就越好。與此同時，使用時間越長，提問的頻率也隨之加快。}
      ]
    </desc>


    <specialTipSize size="5">
      <specialTip openLevel="1" key="1">使用此機器的員工，其所有能力值都會有所提升。</specialTip>
      <specialTip openLevel="2" key="2">使用時間越長，能力值提升的幅度就越高。</specialTip>
      <specialTip openLevel="2" key="3">請確保在機器頂部顯示「YES」時結束使用。若在顯示「NO」時結束使用，所有能力值皆會下降，降幅等同於先前提升的總和。</specialTip>
      <specialTip openLevel="2" key="4">提升的能力值將於次日復原。但若有員工使用機器一次提升了200以上的能力值，則此員工將於當日結束管理時死亡。</specialTip>
      <specialTip openLevel="2" key="5">&lt;注意&gt;：我們確認，使用此異想體超過五次的員工會當場爆炸。</specialTip>
    </specialTipSize>



  </observe>
</creature>